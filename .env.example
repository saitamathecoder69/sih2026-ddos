# Frontend env vars — copy to .env. See INSTRUCTIONS.md for how to get
# each value for free. All optional: with none set, the dashboard runs
# entirely on built-in simulation / static dataset replay as before.

# Enables the "Live Backend" option in the TopBar dataset selector.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Not currently read by the frontend directly (live data flows through
# Supabase Realtime instead), but reserved for a future direct-to-backend
# call — set it to your Render service URL for forward compatibility.
VITE_BACKEND_URL=
