# Copy to .env and fill in — see INSTRUCTIONS.md in the repo root for how
# to get each value for free.

PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Free tier via https://aistudio.google.com/apikey — separate from any
# Gemini consumer subscription. Leave blank to run rules-only.
GEMINI_API_KEY=

# Free tier via https://supabase.com — Settings > API. Leave both blank to
# run without persistence (the backend still answers /ingest either way).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# true only for local dev / the bundled traffic generator. A real
# deployment must leave this false so source IP always comes from the
# actual connection, never a client-supplied value.
ALLOW_SIMULATED_SOURCE_IP=true
